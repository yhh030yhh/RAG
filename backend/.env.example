# ===================== App =====================
PROJECT_NAME=SmartCMS
# 生产环境务必改为随机字符串
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-bytes-long

# ===================== Database =====================
# 开发期默认使用 SQLite（无需额外安装）；生产切换为 PostgreSQL + pgvector
DATABASE_URL=sqlite:///./smartcms.db
# DATABASE_URL=postgresql+psycopg://smartcms:smartcms@localhost:5432/smartcms

# ===================== CORS =====================
CORS_ORIGINS=http://localhost:5173

# ===================== Storage =====================
STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=20

# ===================== 管理员初始化 =====================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# ===================== LLM (DeepSeek) =====================
# LLM_PROVIDER: deepseek | fake（fake 用于离线跑通流程）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===================== Embedding =====================
# EMBEDDING_PROVIDER: cloud | fake（fake 用于离线测试）
EMBEDDING_PROVIDER=cloud
EMBEDDING_API_KEY=
# 硅基流动 BGE-M3（OpenAI 兼容，1024 维）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 阿里 DashScope（OpenAI 兼容模式，1024 维）：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16

# ===================== RAG =====================
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5
SIMILARITY_THRESHOLD=0.3
